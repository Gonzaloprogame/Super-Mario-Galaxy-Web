+// Diagnostics (include/aurora/guest_memory.h): parts of the pipeline left out, and counts of the states built
+static u32 sDebugMask = 0;
+static u32 sDebugStats[AURORA_DEBUG_STAT_COUNT] = {};
+
+static void apply_debug_mask(ShaderConfig& sc) noexcept {
+  auto& stats = sDebugStats;
+  ++stats[AURORA_DEBUG_STAT_STATES];
+  if (sc.fogType != GX_FOG_NONE) {
+    ++stats[AURORA_DEBUG_STAT_FOG];
+  }
+  bool lit = false;
+  for (const auto& cc : sc.colorChannels) {
+    lit = lit || cc.lightingEnabled;
+  }
+  if (lit) {
+    ++stats[AURORA_DEBUG_STAT_LIGHTING];
+  }
+  bool textured = false;
+  for (u8 i = 0; i < sc.tevStageCount; ++i) {
+    textured = textured || sc.tevStages[i].texMapId != GX_TEXMAP_NULL;
+  }
+  if (textured) {
+    ++stats[AURORA_DEBUG_STAT_TEXTURED];
+  }
+  if (sc.numIndStages != 0) {
+    ++stats[AURORA_DEBUG_STAT_INDIRECT];
+  }
+  if (sc.alphaCompare) {
+    ++stats[AURORA_DEBUG_STAT_ALPHA_TEST];
+  }
+  if (g_gxState.depthCompare) {
+    ++stats[AURORA_DEBUG_STAT_DEPTH_TEST];
+  }
+  for (const auto& tcg : sc.tcgs) {
+    if (tcg.src == GX_TG_POS || tcg.src == GX_TG_NRM) {
+      ++stats[AURORA_DEBUG_STAT_TEXGEN_POS_NRM];
+      break;
+    }
+  }
+  const u32 mask = sDebugMask;
+  if (mask == 0) {
+    return;
+  }
+  if ((mask & AURORA_DEBUG_NO_FOG) != 0) {
+    sc.fogType = GX_FOG_NONE;
+    sc.fogRangeEnabled = false;
+  }
+  if ((mask & AURORA_DEBUG_NO_LIGHTING) != 0) {
+    for (auto& cc : sc.colorChannels) {
+      cc = {.matSrc = cc.matSrc};
+    }
+  }
+  if ((mask & AURORA_DEBUG_NO_ALPHA_TEST) != 0) {
+    sc.alphaCompare = {};
+  }
+  if ((mask & (AURORA_DEBUG_TEXTURE_ONLY | AURORA_DEBUG_RASTER_ONLY)) != 0 && sc.tevStageCount > 0) {
+    TevStage stage = sc.tevStages[0];
+    if ((mask & AURORA_DEBUG_TEXTURE_ONLY) != 0) {
+      for (u8 i = 0; i < sc.tevStageCount; ++i) {
+        if (sc.tevStages[i].texMapId != GX_TEXMAP_NULL) {
+          stage = sc.tevStages[i];
+          break;
+        }
+      }
+    }
+    const bool texture = (mask & AURORA_DEBUG_TEXTURE_ONLY) != 0 && stage.texMapId != GX_TEXMAP_NULL;
+    const bool raster = !texture && stage.channelId != GX_COLOR_NULL;
+    stage.colorPass = {GX_CC_ZERO, GX_CC_ZERO, GX_CC_ZERO, texture ? GX_CC_TEXC : raster ? GX_CC_RASC : GX_CC_ONE};
+    stage.alphaPass = {GX_CA_ZERO, GX_CA_ZERO, GX_CA_ZERO, texture ? GX_CA_TEXA : raster ? GX_CA_RASA : GX_CA_KONST};
+    stage.colorOp = {};
+    stage.alphaOp = {};
+    stage.kaSel = GX_TEV_KASEL_1;
+    stage.indTexMtxId = GX_ITM_OFF;
+    stage.indTexWrapS = GX_ITW_OFF;
+    stage.indTexWrapT = GX_ITW_OFF;
+    stage.indTexBiasSel = GX_ITB_NONE;
+    stage.indTexAlphaSel = GX_ITBA_OFF;
+    stage.indTexAddPrev = false;
+    sc.tevStages = {};
+    sc.tevStages[0] = stage;
+    sc.tevStageCount = 1;
+    sc.numIndStages = 0;
+    sc.indStages = {};
+  }
+}
