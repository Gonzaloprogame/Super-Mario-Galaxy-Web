+/* Diagnostics: a mask that leaves out a part of the GX pipeline in the shaders and pipelines built from then on, to
+   see which part a wrong picture comes from (AURORA_DEBUG_*); and counts of the pipeline states built, by what they
+   use (AURORA_DEBUG_STAT_*, cumulative). On the thread that runs Aurora. */
+enum {
+  AURORA_DEBUG_NO_FOG = 1 << 0,         /* no fog */
+  AURORA_DEBUG_NO_LIGHTING = 1 << 1,    /* the channels' material colour, unlit */
+  AURORA_DEBUG_TEXTURE_ONLY = 1 << 2,   /* the first stage's texture, as is */
+  AURORA_DEBUG_RASTER_ONLY = 1 << 3,    /* the first stage's colour channel, as is */
+  AURORA_DEBUG_NO_ALPHA_TEST = 1 << 4,  /* no alpha compare */
+  AURORA_DEBUG_NO_DEPTH_TEST = 1 << 5,  /* depth compare always */
+  AURORA_DEBUG_LOG_FRAME = 1 << 6,      /* setting it records the next frame's draws, copies and host markers */
+};
+enum {
+  AURORA_DEBUG_STAT_STATES,
+  AURORA_DEBUG_STAT_FOG,
+  AURORA_DEBUG_STAT_LIGHTING,
+  AURORA_DEBUG_STAT_TEXTURED,
+  AURORA_DEBUG_STAT_INDIRECT,
+  AURORA_DEBUG_STAT_ALPHA_TEST,
+  AURORA_DEBUG_STAT_DEPTH_TEST,
+  AURORA_DEBUG_STAT_TEXGEN_POS_NRM, /* texture coordinates from position or normal (projections, reflections) */
+  AURORA_DEBUG_STAT_COUNT
+};
+void aurora_set_debug_mask(uint32_t mask);
+void aurora_get_debug_stats(uint32_t out[AURORA_DEBUG_STAT_COUNT]);
+/* The frame AURORA_DEBUG_LOG_FRAME recorded, one line per item, once it has ended: its length (0 when there is none);
+   copied to `out` and dropped when `size` holds it. */
+size_t aurora_take_debug_frame_log(char* out, size_t size);
+
 #ifdef __cplusplus
 }
 #endif
