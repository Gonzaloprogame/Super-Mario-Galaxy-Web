+// AURORA_DEBUG_LOG_FRAME: one line per draw of the logged frame
+static void log_frame_draw(GXPrimitive prim, u16 vtxCount) noexcept {
+  const auto& st = g_gxState;
+  const auto& vp = st.renderViewport;
+  std::string maps;
+  u32 seen = 0;
+  for (u8 i = 0; i < st.numTevStages; ++i) {
+    const auto id = st.tevStages[i].texMapId;
+    if (id == GX_TEXMAP_NULL || (seen & (1u << (id & 7))) != 0) {
+      continue;
+    }
+    seen |= 1u << (id & 7);
+    const auto& t = st.loadedTextures[id & 7];
+    const bool copy = t.data != nullptr && st.copyTextures.contains(t.data);
+    maps += fmt::format(" map{} {}x{} f{} @{:08X}{}", static_cast<int>(id), t.width(), t.height(), t.format(),
+                        (t.image3 & 0xFFFFFF) << 5, copy ? " COPY" : t.data == nullptr ? " NODATA" : "");
+  }
+  g_debugFrameText += fmt::format("{} draw p{:02X} n{} vp {:.0f},{:.0f} {:.0f}x{:.0f} z{:.3f}-{:.3f} zc{}{}{} bl{}{}{} cu{}{} tev{} ch{} tg{} ind{} ac{}{}",
+           g_debugFrameItem++, static_cast<int>(prim), vtxCount, vp.left, vp.top, vp.width, vp.height, vp.znear,
+           vp.zfar, st.depthCompare ? 1 : 0, static_cast<int>(st.depthFunc), st.depthUpdate ? 1 : 0,
+           static_cast<int>(st.blendMode), static_cast<int>(st.blendFacSrc), static_cast<int>(st.blendFacDst),
+           st.colorUpdate ? 1 : 0, st.alphaUpdate ? 1 : 0, st.numTevStages, st.numChans, st.numTexGens,
+           st.numIndStages, st.alphaCompare ? 1 : 0, maps);
+  g_debugFrameText += '\n';
+}
