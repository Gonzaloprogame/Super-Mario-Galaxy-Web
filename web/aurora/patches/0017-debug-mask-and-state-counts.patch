+void aurora_set_debug_mask(uint32_t mask) {
+  // AURORA_DEBUG_LOG_FRAME: the frame after the bit is set is logged, once
+  if (aurora::gx::g_debugFrameLog) {
+    aurora::gx::sDebugFrameDone = std::move(aurora::gx::g_debugFrameText);
+  }
+  aurora::gx::g_debugFrameText.clear();
+  aurora::gx::g_debugFrameLog =
+      (mask & AURORA_DEBUG_LOG_FRAME) != 0 && (aurora::gx::sDebugMask & AURORA_DEBUG_LOG_FRAME) == 0;
+  aurora::gx::g_debugFrameItem = 0;
+  if (mask != aurora::gx::sDebugMask) {
+    aurora::gx::sDebugMask = mask;
+    aurora::gx::g_gxState.dirty |= aurora::gx::DirtyPipeline;
+  }
+}
+
+void aurora_get_debug_stats(uint32_t out[AURORA_DEBUG_STAT_COUNT]) {
+  for (int i = 0; i < AURORA_DEBUG_STAT_COUNT; ++i) {
+    out[i] = aurora::gx::sDebugStats[i];
+  }
+}
+
+size_t aurora_take_debug_frame_log(char* out, size_t size) {
+  auto& done = aurora::gx::sDebugFrameDone;
+  if (done.empty()) {
+    return 0;
+  }
+  const size_t length = done.size();
+  if (out != nullptr && size >= length) {
+    memcpy(out, done.data(), length);
+    done.clear();
+  }
+  return length;
+}
