+void aurora_set_debug_mask(uint32_t mask) {
+  if (mask != aurora::gx::sDebugMask) {
+    aurora::gx::sDebugMask = mask;
+    aurora::gx::g_gxState.dirty |= aurora::gx::DirtyPipeline;
+  }
+}
+
+void aurora_get_debug_stats(uint32_t out[AURORA_DEBUG_STAT_COUNT]) {
+  for (int i = 0; i < AURORA_DEBUG_STAT_COUNT; ++i) {
+    out[i] = aurora::gx::sDebugStats[i];
+  }
