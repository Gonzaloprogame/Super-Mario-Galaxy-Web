+// Textures named by the hardware's registers (the game's SDK writes them as the console does; with a guest resolver).
+// A TLUT is loaded into TMEM (BP 0x64/0x65) and a texture map selects one by its TMEM offset (TX_SETTLUT); both are
+// tracked here and turned into Aurora's texture and TLUT slots at the next draw (sync_guest_textures).
+struct GuestTlut {
+  const u8* data = nullptr;
+  u16 numEntries = 0;
+};
+std::array<GuestTlut, 1024> sGuestTluts;     // by TMEM offset (512-byte units from 0x80000)
+std::array<u32, MaxTextures> sGuestTlutRegs{}; // TX_SETTLUT per texture map
+u32 sGuestTexturesDirty = 0;                   // texture maps whose registers changed
+} // namespace
+} // namespace aurora::gx
