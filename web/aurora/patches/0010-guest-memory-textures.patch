 namespace {
 constexpr Module Log{"aurora::gx::fifo"};
@@ -296,6 +311,21 @@ void bp_tlut_load(u8, u32 value) noexcept {
     slot.loadTlut0 = g_gxState.bpRegCache[0x64];
     slot.numEntries = static_cast<u16>(reg_get(value, 10, 10) + 1);
   }
+  // The hardware's form: the source's physical address / 32 in BP 0x64, the TMEM offset and the count in 16-entry units
+  const u32 physical = reg_get(g_gxState.bpRegCache[0x64], 24, 0) << 5;
+  u32 available = 0;
+  const u8* data = guest_memory(physical, &available);
+  if (data != nullptr) {
+    const u32 numEntries = reg_get(value, 11, 10) * 16;
+    auto& tlut = sGuestTluts[reg_get(value, 10, 0)];
+    if (numEntries * sizeof(u16) <= available) {
+      tlut = {data, static_cast<u16>(numEntries)};
+    } else {
+      Log.error("TLUT load from 0x{:08X}: {} entries, {} bytes in guest memory", physical, numEntries, available);
+      tlut = {};
+    }
+    sGuestTexturesDirty = (1u << MaxTextures) - 1;
+  }
 }
 
