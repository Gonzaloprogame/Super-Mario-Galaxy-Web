+
+void sync_guest_textures() noexcept {
+  if (sGuestTexturesDirty == 0 || sGuestResolver == nullptr) {
+    return;
+  }
+  for (u32 i = 0; i < MaxTextures; ++i) {
+    if ((sGuestTexturesDirty & (1u << i)) == 0) {
+      continue;
+    }
+    auto& slot = g_gxState.loadedTextures[i];
+    if (slot.image0 == UINT32_MAX) {
+      continue; // never loaded
+    }
+    // Size and format come from Image0 (GXTexObj_::width/height/format); mipmaps from the min filter, as the hardware
+    // samples them; the data from Image3's physical address / 32. No object identity: Aurora's content cache hashes
+    // the data each time the texture is bound, which also catches the game rewriting it.
+    const u32 physical = (slot.image3 & 0xFFFFFF) << 5;
+    u32 available = 0;
+    const u8* data = guest_memory(physical, &available);
+    const u32 minFilter = (slot.mode0 >> 5) & 7;
+    slot.flags = (minFilter & 3) == 1 || (minFilter & 3) == 2 ? 1 : 0;
+    slot.mWidth = 0;
+    slot.mHeight = 0;
+    slot.mFormat = gfx::InvalidTextureFormat;
+    slot.texObjId = 0;
+    slot.texDataVersion = 0;
+    slot.data = nullptr;
+    if (data == nullptr) {
+      fifo::Log.error("Texture map {}: image at 0x{:08X} is not guest memory", i, physical);
+      continue;
+    }
+    const size_t bytes = texture::texture_source_size(slot.format(), slot.width(), slot.height(), slot.mip_count());
+    if (bytes == 0 || bytes > available) {
+      fifo::Log.error("Texture map {}: {}x{} format {} with {} levels needs {} bytes at 0x{:08X}, {} in guest memory", i,
+                slot.width(), slot.height(), slot.format(), slot.mip_count(), bytes, physical, available);
+      continue;
+    }
+    slot.data = data;
+    if (is_palette_format(slot.format())) {
+      // Each map gets its own TLUT slot, filled from the TMEM offset it selects
+      const u32 tlutReg = sGuestTlutRegs[i];
+      const auto& source = sGuestTluts[tlutReg & 0x3FF];
+      auto& tlut = g_gxState.loadedTluts[i];
+      tlut.data = source.data;
+      tlut.numEntries = source.numEntries;
+      tlut.format = static_cast<GXTlutFmt>((tlutReg >> 10) & 3);
+      tlut.tlutObjId = 0;
+      tlut.tlutDataVersion = 0;
+      tlut.flags = 0;
+      slot.tlut = static_cast<GXTlut>(i);
+      if (source.data == nullptr) {
+        fifo::Log.error("Texture map {}: no TLUT loaded at TMEM offset 0x{:03X}", i, tlutReg & 0x3FF);
+      }
+    }
+  }
+  sGuestTexturesDirty = 0;
+}
 } // namespace aurora::gx
 
