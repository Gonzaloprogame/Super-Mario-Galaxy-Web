 // EFB copy trigger (0x52)
+// The texture format of a hardware texture copy: the PE's 4-bit format (TEX_FORMAT and TEX_FORMATH), its colour
+// conversion (CCV 3: intensity) and whether it copies depth (GXCopyTex sets the PE pixel format to Z24 for it).
+GXTexFmt hardware_copy_format(u32 cmd, bool depth) noexcept {
+  const u32 fmt = reg_get(cmd, 3, 4) | reg_get(cmd, 1, 3) << 3;
+  if (depth) {
+    switch (fmt) {
+    case 0x0: return GX_CTF_Z4;
+    case 0x1: return GX_TF_Z8;
+    case 0x6: return GX_TF_Z24X8;
+    case 0x9: return GX_CTF_Z8M;
+    case 0xA: return GX_CTF_Z8L;
+    case 0xB: return GX_TF_Z16;
+    case 0xC: return GX_CTF_Z16L;
+    default: break;
+    }
+  } else if (reg_get(cmd, 2, 15) == 3) {
+    switch (fmt) {
+    case 0x0: return GX_TF_I4;
+    case 0x1: return GX_TF_I8;
+    case 0x2: return GX_TF_IA4;
+    case 0x3: return GX_TF_IA8;
+    case 0x6: return GX_CTF_YUVA8;
+    default: break;
+    }
+  } else {
+    switch (fmt) {
+    case 0x0: return GX_CTF_R4;
+    case 0x2: return GX_CTF_RA4;
+    case 0x3: return GX_CTF_RA8;
+    case 0x4: return GX_TF_RGB565;
+    case 0x5: return GX_TF_RGB5A3;
+    case 0x6: return GX_TF_RGBA8;
+    case 0x7: return GX_CTF_A8;
+    case 0x8: return GX_CTF_R8;
+    case 0x9: return GX_CTF_G8;
+    case 0xA: return GX_CTF_B8;
+    case 0xB: return GX_CTF_RG8;
+    case 0xC: return GX_CTF_GB8;
+    default: break;
+    }
+  }
+  return static_cast<GXTexFmt>(gfx::InvalidTextureFormat);
+}
