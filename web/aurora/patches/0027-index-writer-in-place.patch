diff -ruN a/lib/gx/index_writer.hpp b/lib/gx/index_writer.hpp
--- a/lib/gx/index_writer.hpp	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/gx/index_writer.hpp	2026-11-04 15:55:40.338482159 +0000
@@ -0,0 +1,95 @@
+#pragma once
+
+// The index list of one GX primitive, written in place in the frame's index buffer. It replaces appending each index
+// to a staging buffer that was then copied to the frame's (prepare_idx_buffer + push_indices, about a tenth of the
+// render thread in Super Mario Galaxy, where ~39 000 primitives a frame are merged into a few hundred draws).
+// The values and counts are those prepare_idx_buffer gave, quirks included (web/tests/index_writer_test.cpp checks
+// it against a copy of it): a quad list whose count is not a multiple of 4 also writes its last, partial quad, and the
+// count is returned as a u16, as before.
+
+#include <dolphin/gx/GXEnum.h>
+
+#include <cstdint>
+
+namespace aurora::gx::fifo {
+
+// The number of indices write_idx_buffer writes, or UINT32_MAX for a primitive it does not know
+constexpr uint32_t idx_buffer_length(GXPrimitive prim, uint16_t vtxCount) noexcept {
+  switch (prim) {
+  case GX_QUADS:
+    return (static_cast<uint32_t>(vtxCount) + 3) / 4 * 6;
+  case GX_TRIANGLES:
+    return vtxCount;
+  case GX_TRIANGLEFAN:
+  case GX_TRIANGLESTRIP:
+    return vtxCount < 3 ? vtxCount : (static_cast<uint32_t>(vtxCount) - 3) * 3 + 3;
+  case GX_LINES:
+  case GX_LINESTRIP:
+  case GX_POINTS:
+    return 6; // one quad, drawn once per instance
+  default:
+    return UINT32_MAX;
+  }
+}
+
+// Writes idx_buffer_length(prim, vtxCount) indices to out; returns their count as a u16
+inline uint16_t write_idx_buffer(uint16_t* out, GXPrimitive prim, uint16_t vtxStart, uint16_t vtxCount) noexcept {
+  const uint32_t length = idx_buffer_length(prim, vtxCount);
+  switch (prim) {
+  case GX_QUADS:
+    for (uint32_t v = 0; v < vtxCount; v += 4, out += 6) {
+      const uint16_t i0 = static_cast<uint16_t>(vtxStart + v);
+      out[0] = i0;
+      out[1] = static_cast<uint16_t>(i0 + 1);
+      out[2] = static_cast<uint16_t>(i0 + 2);
+      out[3] = static_cast<uint16_t>(i0 + 2);
+      out[4] = static_cast<uint16_t>(i0 + 3);
+      out[5] = i0;
+    }
+    break;
+  case GX_TRIANGLES:
+    for (uint32_t v = 0; v < vtxCount; ++v) {
+      out[v] = static_cast<uint16_t>(vtxStart + v);
+    }
+    break;
+  case GX_TRIANGLEFAN:
+  case GX_TRIANGLESTRIP: {
+    const uint32_t first = vtxCount < 3 ? vtxCount : 3;
+    for (uint32_t v = 0; v < first; ++v) {
+      *out++ = static_cast<uint16_t>(vtxStart + v);
+    }
+    if (prim == GX_TRIANGLEFAN) {
+      for (uint32_t v = 3; v < vtxCount; ++v, out += 3) {
+        const uint16_t idx = static_cast<uint16_t>(vtxStart + v);
+        out[0] = vtxStart;
+        out[1] = static_cast<uint16_t>(idx - 1);
+        out[2] = idx;
+      }
+    } else {
+      for (uint32_t v = 3; v < vtxCount; ++v, out += 3) {
+        const uint16_t idx = static_cast<uint16_t>(vtxStart + v);
+        // Every other triangle swaps its first two corners, keeping the strip's winding
+        out[0] = static_cast<uint16_t>((v & 1) == 0 ? idx - 2 : idx - 1);
+        out[1] = static_cast<uint16_t>((v & 1) == 0 ? idx - 1 : idx - 2);
+        out[2] = idx;
+      }
+    }
+    break;
+  }
+  case GX_LINES:
+  case GX_LINESTRIP:
+  case GX_POINTS:
+    out[0] = 0;
+    out[1] = 1;
+    out[2] = 3;
+    out[3] = 3;
+    out[4] = 2;
+    out[5] = 0;
+    break;
+  default:
+    return 0;
+  }
+  return static_cast<uint16_t>(length);
+}
+
+} // namespace aurora::gx::fifo
