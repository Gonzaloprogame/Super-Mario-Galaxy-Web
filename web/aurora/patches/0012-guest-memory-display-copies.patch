+// The lines a display copy writes for `height` EFB lines at the vertical scale register's value (256 / scale): the
+// SDK's __GXGetNumXfbLines.
+u32 display_copy_lines(u32 height, u32 scale) noexcept {
+  if (scale == 0) {
+    return height;
+  }
+  u32 lines = (height - 1) * 0x100 / scale + 1;
+  if (scale > 0x80 && scale < 0x100) {
+    u32 odd = scale;
+    while (odd % 2 == 0) {
+      odd /= 2;
+    }
+    if (height % odd == 0) {
+      ++lines;
+    }
+  }
+  return std::min<u32>(lines, 0x400);
+}
