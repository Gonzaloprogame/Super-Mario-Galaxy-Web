-void cp_arraybase_unsupported(u8, u32) noexcept {
-  Log.error("CP_REG_ARRAYBASE_ID is not supported. Use GX_AURORA_LOAD_ARRAYBASE instead.");
+void cp_arraybase(u8 addr, u32 value) noexcept {
+  const u32 attrIdx = addr - 0xA0 + GX_VA_POS;
+  u32 available = 0;
+  const u8* data = guest_memory(value, &available);
+  if (data == nullptr) {
+    Log.error("CP array base 0x{:08X} (attribute {}) is not guest memory; use GX_AURORA_LOAD_ARRAYBASE", value,
+              attrIdx);
+    return;
+  }
+  auto& array = g_gxState.arrays[attrIdx];
+  if (array.data == data && !array.le && array.guestAvailable == available) {
+    return;
+  }
+  if (array.le) {
+    // Endianness is baked into the shader; guest arrays are big-endian
+    g_gxState.dirty |= DirtyPipeline;
+  }
+  array.data = data;
+  array.size = 0;
+  array.le = false;
+  array.guestAvailable = available;
+  array.cachedRange = {};
+  g_gxState.dirty |= DirtyImmediates;
 }
 
