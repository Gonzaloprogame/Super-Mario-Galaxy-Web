+// Arrays in guest memory (set by a CP array base) have no size in the registers: upload what the draws' indices reach.
+// Growing an array re-uploads it, which changes the draw's immediates (no merge with the previous draw).
+static void bound_guest_arrays(GXVtxFmt fmt, std::span<const u8> vertexData, u32 vtxSize, u16 vtxCount) noexcept {
+  const auto& vtxFmt = g_gxState.vtxFmts[fmt];
+  u32 offset = 0;
+  for (int i = GX_VA_PNMTXIDX; i <= GX_VA_TEX7; ++i) {
+    const auto desc = g_gxState.vtxDesc[i];
+    if (desc == GX_NONE) {
+      continue;
+    }
+    const auto attr = static_cast<GXAttr>(i);
+    const auto& attrFmt = vtxFmt.attrs[i];
+    const u32 elemSize = comp_type_size(attr, attrFmt.type) * comp_cnt_count(attr, attrFmt.cnt);
+    if (desc == GX_DIRECT) {
+      offset += elemSize;
+      continue;
+    }
+    const bool nbt3 = i == GX_VA_NRM && attrFmt.cnt == GX_NRM_NBT3;
+    const u32 idxSize = desc == GX_INDEX8 ? 1 : 2;
+    const u32 idxCount = nbt3 ? 3 : 1;
+    auto& array = g_gxState.arrays[i];
+    if (array.guestAvailable != 0) {
+      u32 maxIdx = 0;
+      for (u32 v = 0; v < vtxCount; ++v) {
+        const u8* p = vertexData.data() + v * vtxSize + offset;
+        for (u32 k = 0; k < idxCount; ++k) {
+          const u32 idx = idxSize == 1 ? p[k] : read_bits<u16>(p + k * 2);
+          maxIdx = std::max(maxIdx, idx);
+        }
+      }
+      // An NBT3 index addresses one of the three vectors
+      const u32 reach = maxIdx * array.stride + (nbt3 ? elemSize / 3 : elemSize);
+      const u32 needed = std::min((reach + 3) & ~3u, array.guestAvailable);
+      if (needed > array.size) {
+        array.size = needed;
+        array.cachedRange = {};
+        g_gxState.dirty |= DirtyImmediates;
+      }
+    }
+    offset += idxSize * idxCount;
+  }
+}
