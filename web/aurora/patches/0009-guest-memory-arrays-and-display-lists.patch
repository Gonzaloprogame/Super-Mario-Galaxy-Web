+/* The hardware command stream names memory by the guest's 32-bit physical addresses (CP array bases, display list
+   calls). A resolver maps one to host memory: it returns where `physical` is, with the bytes readable from there in
+   *available, or NULL when the address is not guest memory. Without a resolver those commands are ignored, as before. */
+typedef const uint8_t* (*AuroraGuestResolver)(uint32_t physical, uint32_t* available);
+void aurora_set_guest_resolver(AuroraGuestResolver resolver);
+
+#ifdef __cplusplus
+}
+#endif
