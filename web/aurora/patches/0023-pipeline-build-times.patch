+// The time spent creating pipelines (web: aurora_pipeline_build_times, for the host's report). In the browser build
+// there is no pipeline thread: each is created on the render thread, a frame waits for it.
+static std::atomic<uint64_t> g_buildNs{0}, g_buildMaxNs{0};
+static std::atomic<uint32_t> g_buildCount{0};
+template <typename Fn>
+static auto timed_build(Fn&& fn) {
+  const auto start = std::chrono::steady_clock::now();
+  auto result = fn();
+  const auto ns = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count());
+  g_buildNs.fetch_add(ns, std::memory_order_relaxed);
+  g_buildCount.fetch_add(1, std::memory_order_relaxed);
+  uint64_t max = g_buildMaxNs.load(std::memory_order_relaxed);
+  while (ns > max && !g_buildMaxNs.compare_exchange_weak(max, ns, std::memory_order_relaxed)) {
+  }
+  return result;
+}
