+// Guest arrays uploaded in this frame, by their memory and size: a GXInvalidateVtxCache (which the game calls between
+// most shapes) drops every array's range, and each draw would upload its arrays again; a model's shapes share them, so
+// a stage's frame went past the storage buffer's 8 MiB. An upload is reused within its frame until the game writes
+// that memory for the GPU (aurora_guest_written: its cache flushes, which the console needs before the GPU reads).
+struct GuestArrayUpload {
+  const u8* data;
+  u32 size;
+  gfx::Range range;
+};
+static std::vector<GuestArrayUpload> sGuestArrayUploads;
+static uint64_t sGuestArrayUploadsFrame = UINT64_MAX;
+
+static gfx::Range upload_array(const void* data, u32 size) noexcept {
+  const uint64_t frame = gfx::frame_generation();
+  if (frame != sGuestArrayUploadsFrame) {
+    sGuestArrayUploads.clear();
+    sGuestArrayUploadsFrame = frame;
+  }
+  for (const auto& upload : sGuestArrayUploads) {
+    if (upload.data == data && upload.size == size) {
+      return upload.range;
+    }
+  }
+  const auto range = gfx::push_storage(static_cast<const uint8_t*>(data), size);
+  if (range.size != 0) {
+    sGuestArrayUploads.push_back({static_cast<const u8*>(data), size, range});
+  }
+  return range;
+}
+
+extern "C" void aurora_guest_written(const void* data, size_t size) {
+  const u8* const begin = static_cast<const u8*>(data);
+  std::erase_if(sGuestArrayUploads, [begin, size](const GuestArrayUpload& upload) {
+    return upload.data < begin + size && begin < upload.data + upload.size;
+  });
+}
