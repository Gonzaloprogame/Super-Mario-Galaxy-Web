+void push_depth_clear(float depth) noexcept {
+  const auto target = get_render_target_size();
+  const auto& vp = g_recorder.cachedViewport;
+  const auto& sc = g_recorder.cachedScissor;
+  const int32_t left = std::max({static_cast<int32_t>(std::floor(vp.left)), sc.x, 0});
+  const int32_t top = std::max({static_cast<int32_t>(std::floor(vp.top)), sc.y, 0});
+  const int32_t right = std::min({static_cast<int32_t>(std::ceil(vp.left + vp.width)), sc.x + sc.width,
+                                  static_cast<int32_t>(target.x)});
+  const int32_t bottom = std::min({static_cast<int32_t>(std::ceil(vp.top + vp.height)), sc.y + sc.height,
+                                   static_cast<int32_t>(target.y)});
+  if (right <= left || bottom <= top) {
+    return;
+  }
+  push_draw_command(clear::DrawData{
+      .pipeline = pipeline_ref(clear::PipelineConfig{.clearColor = false, .clearAlpha = false, .clearDepth = true}),
+      .color = wgpu::Color{},
+      .depth = depth,
+      .rect = ClipRect{left, top, right - left, bottom - top},
+  });
+  // The clear draw sets its own viewport and scissor
+  push_command(CommandType::SetViewport, Command::Data{.setViewport = g_recorder.cachedViewport});
+  push_command(CommandType::SetScissor, Command::Data{.setScissor = g_recorder.cachedScissor});
+}
